.vercel
.env*

# 相依套件與建置產物：不進版控
node_modules
dist

# 一次性的 migration／規則備份，留在本機當還原點即可
_migration_backup_*/
_rules_backup_*.rules
_stage_backfill_backup.json

# 一次性診斷／修復腳本留在本機；可重用的請整理進 scripts/
/_*.mjs

# 本機驗證用的暫存預覽/測試輸出，不進版控
.preview-tmp/

# Firestore 模擬器（npm run test:rules）留下的 log
firestore-debug.log
firebase-debug.log

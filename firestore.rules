// Rules Updated: 2026-08-11 — 剪輯師角色權限 + 請款/對帳 + 素材刪除保護
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: uid (string), email (string), role (string: engineer|manager|employee), displayName (string)
    //
    // Collection: vendors
    // Fields: name (string), socialAccounts (list), postingHabits (list), cooperationItems (list), createdBy (string), createdAt (timestamp)
    //
    // Collection: posts
    // Fields: vendorId (string), assetId (string), title (string), content (string), status (string: draft|scheduled|published), 
    //         scheduledAt (string/timestamp), type (string), contentType (string: video|post), 
    //         clientConfirmed (bool), internalConfirmed (bool), platforms (list), createdBy (string)
    //
    // Collection: assets
    // Fields: vendorId (string), title (string), url (string), type (string: video|post), category (string), status (string: available|used), 
    //         usedInPostId (string), createdAt (string), createdBy (string)
    //
    // Collection: dismissedHabits
    // Fields: vendorId (string), habitTime (string), date (string: YYYY-MM-DD), createdAt (timestamp)
    //
    // Collection: billingContracts
    // Fields: vendorId (string), services (list), billingDay (int), totalAmount (int), status (string: active|paused|ended)
    //
    // Collection: billingRecords
    // Fields: vendorId (string), contractId (string), billingMonth (string: YYYY-MM), dueDate (string: YYYY-MM-DD), amount (int), status (string: pending|paid|overdue)
    //
    // Collection: line_connections
    // Fields: lineUserId (string), linePictureUrl (string), lineDisplayName (string), UserId (string), createdAt (string)
    //
    // Collection: shootBookings
    // Fields: vendorId (string), scheduledDate (string: YYYY-MM-DD), status (string: booked|completed|postponed|cancelled),
    //         bookedByUid (string), bookedByName (string), reason (string: client|internal|other), deliveredCount (int),
    //         previousBookingId (string), createdAt (string), resolvedAt (string)
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'engineer' ||
        (request.auth.token.email == "denmark1125@gmail.com" && request.auth.token.email_verified == true) ||
        (request.auth.token.email == "david@forest.system")
      );
    }

    function isManager() {
      return isAuthenticated() && (getUserData().role == 'manager' || isAdmin());
    }

    // 剪輯師(外包)：權限最收斂的角色，只能讀取自己被指派的廠商範圍，其餘角色一律不受此限制
    function isEditorRole() {
      return isAuthenticated() && getUserData().role == 'editor';
    }

    function editorAssignedVendors() {
      return getUserData().get('assignedVendorIds', []);
    }

    function editorCanAccessVendor(vendorId) {
      return !isEditorRole() || vendorId in editorAssignedVendors();
    }

    // 2026-08-20 逐片指派：一支片可以指名給非該廠商預設剪輯師的人做。
    // 存取判斷因此不能只看廠商，還要認「這支片指名給我」。
    //
    // ⚠️ myEditorId() != '' 這個條件缺不得：myEditorId() 讀的是 users/{uid}.linkedEditorId，
    // 剪輯師帳號若沒綁 editors 標籤會回空字串，而大多數素材的 editorId 也是空的，
    // 少了它就變成 '' == '' 恆真 —— 那個帳號會讀得到全庫所有未指派的素材。
    function assetAssignedToMe(data) {
      return isEditorRole()
        && myEditorId() != ''
        && data.get('editorId', '') == myEditorId();
    }

    // 素材的存取邊界：廠商在我範圍內，或這支片指名給我。
    // 注意這不會讓被指名的人看到該廠商的其他片 —— 逐文件評估，一支算一支。
    function editorCanAccessAsset(data) {
      return !isEditorRole()
        || (data.vendorId in editorAssignedVendors())
        || assetAssignedToMe(data);
    }

    // 剪輯師對 assets 只能碰這幾個欄位（交片送審、上傳雲端、請款金額），其餘欄位一律不可變動。
    // flowStage/flowSince/flowLog 是交棒鏈本體，cloudUploadedAt 是「已上傳雲端」的時間戳，
    // editorFee/billableEditorId/editorInvoiceId 是請款用的三個欄位。
    function isEditorAssetUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['stage', 'url', 'approved', 'submittedBy', 'submittedAt',
                  'flowStage', 'flowSince', 'flowLog', 'cloudUploadedAt',
                  'editorFee', 'billableEditorId', 'editorInvoiceId']);
    }

    // 這位使用者代表哪一位剪輯師標籤。請款單的擁有權判斷全部靠這個。
    function myEditorId() {
      return getUserData().get('linkedEditorId', '');
    }

    // 已經納進某張請款單＝金額與綁定關係全部凍結
    function assetInvoiced() {
      return resource.data.get('editorInvoiceId', '') != '';
    }

    function touchesBillingFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['editorFee', 'billableEditorId', 'editorInvoiceId',
                 'legacySettlementStatus', 'legacySettledAt', 'legacySettledAmount',
                 'legacySettlementNote', 'legacySettlementSource',
                 'legacyReviewedAt', 'legacyReviewedByUid']);
    }

    // 內部人員把 editorInvoiceId 清空 —— 請款單作廢後要讓那批片回到可請款清單。
    // 原本的凍結是「任何人都不能動已入單素材的計費欄位」，結果作廢單子之後那批片
    // 既不能重新請款（剪輯師的錢消失）也不能刪，是死結。
    // 這條鎖真正要防的是「剪輯師自己清掉紀錄重複請款」（見 billableEditorIsSelf 的註解），
    // 所以只要把剪輯師排除在外，意圖就完整保留了。
    function internalUnlockingInvoice() {
      return isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['editorInvoiceId'])
        && request.resource.data.get('editorInvoiceId', '') == '';
    }

    // 剪輯師只能把「計費歸屬」蓋成自己 —— 防止共用同一個 IP 的兩位剪輯師互搶對方的片來請款
    function billableEditorIsSelf() {
      return !isEditorRole()
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['billableEditorId'])
        // 清空是合法的：取消上傳會把凍結的計費歸屬一起解除，之後可能改派給別人再重新凍結。
        // 這不會製造搶片管道——剪輯師清掉後重新上傳，寫進去的還是他自己。
        || request.resource.data.get('billableEditorId', '') == ''
        || request.resource.data.billableEditorId == myEditorId();
    }

    // 「校正起始欠片」是比一般廠商編輯更敏感的財務類數字，預設只有工程師能改；
    // 工程師可以個別在 users/{uid}.canEditDeficitBaseline 開權限給特定人（不需要是 manager）
    function canEditDeficitBaseline() {
      return isAuthenticated() && (isAdmin() || getUserData().get('canEditDeficitBaseline', false) == true);
    }

    // 改派剪輯師。editorId 原本在規則裡完全裸奔（只有型別檢查），
    // 加這條是為了擋「已經請款了還去改歸屬」＝事後改帳。
    function touchesEditorAssignment() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['editorId']);
    }

    function touchesDeficitBaseline() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['manualDeficitBaseline', 'manualDeficitUpdatedAt', 'deficitEntries']);
    }

    function touchesOnlyDeficitBaseline() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['manualDeficitBaseline', 'manualDeficitUpdatedAt', 'deficitEntries']);
    }

    function touchesDeficitPermission() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['canEditDeficitBaseline']);
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    
    function isValidVendor(data) {
      return data.keys().hasAll(['name', 'createdBy']) &&
             isValidString(data.name, 100) &&
             data.createdBy is string &&
             (!('cooperationItems' in data) || data.cooperationItems is list) &&
             (!('monthlyTargetPosts' in data) || data.monthlyTargetPosts is int) &&
             (!('monthlyTargetVideos' in data) || data.monthlyTargetVideos is int) &&
             (!('editorId' in data) || data.editorId is string) &&
             // 廠商名稱快照：給讀不到 vendor 文件的被指名剪輯師用（見 types.ts Asset.vendorName）。
             // 刻意不加進 isEditorAssetUpdate() 白名單——剪輯師不能自己改這個顯示名稱。
             (!('vendorName' in data) || data.vendorName is string) &&
             // 認列月份（YYYY-MM）：手動標記完成時寫入，讓那支片計入該月已交。
             // 不放進 isEditorAssetUpdate() 白名單——剪輯師不能自己決定認列哪個月。
             (!('recognizedMonth' in data) || data.recognizedMonth is string) &&
             (!('editorName' in data) || data.editorName is string) &&
             (!('selfPublishing' in data) || data.selfPublishing is bool);
    }

    function isValidPost(data) {
      return data.keys().hasAll(['vendorId', 'title', 'status']) &&
             data.vendorId is string &&
             (data.title is string && data.title.size() <= 1000) &&
             data.status in ['draft', 'scheduled', 'published', 'pending'] &&
             (!('createdBy' in data) || data.createdBy == null || data.createdBy is string) &&
             (!('createdAt' in data) || data.createdAt == null || data.createdAt is string) &&
             (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is string) &&
             (!('assetId' in data) || data.assetId == null || data.assetId is string) &&
             (!('content' in data) || data.content == null || data.content is string) &&
             (!('clientConfirmed' in data) || data.clientConfirmed == null || data.clientConfirmed is bool) &&
             (!('internalConfirmed' in data) || data.internalConfirmed == null || data.internalConfirmed is bool) &&
             (!('isRecognized' in data) || data.isRecognized == null || data.isRecognized is bool) &&
             (!('targetMonth' in data) || data.targetMonth == null || data.targetMonth is string) &&
             (!('postUrl' in data) || data.postUrl == null || data.postUrl is string) &&
             (!('platforms' in data) || data.platforms == null || data.platforms is list) &&
             (!('publishedPlatforms' in data) || data.publishedPlatforms == null || data.publishedPlatforms is list) &&
             (!('type' in data) || data.type == null || data.type is string) &&
             (!('contentType' in data) || data.contentType == null || data.contentType is string) &&
             (!('scheduledAt' in data) || data.scheduledAt == null || data.scheduledAt is string);
    }

    function isValidAsset(data) {
      // ⚠️ stage 刻意不放進 hasAll：2026-08-12 查出全庫有 28 支舊素材根本沒有這個欄位，
      // 而 hasAll 是「整份文件」的檢查，缺一欄就等於那支素材**任何更新都被拒絕**——
      // 症狀是編輯貼文時換素材會噴「儲存失敗」，而且完全看不出原因。
      // 程式端本來就容忍缺 stage（vendorStatus 把它當成片、deriveFlowStage 也推得出來），
      // 規則沒理由比程式更嚴。新增欄位時一律走「選填 + 型別檢查」，不要再往 hasAll 加。
      return data.keys().hasAll(['vendorId', 'title', 'type', 'status', 'approved', 'createdBy', 'createdAt']) &&
             data.vendorId is string &&
             isValidString(data.title, 200) &&
             data.type in ['video', 'post'] &&
             data.status in ['available', 'used', 'archived'] &&
             (!('stage' in data) || data.stage in ['raw', 'finished']) &&
             data.approved is bool &&
             data.createdBy is string &&
             data.createdAt is string &&
             (!('url' in data) || data.url is string) &&
             (!('category' in data) || data.category is string) &&
             (!('editorId' in data) || data.editorId is string) &&
             // 交棒鏈（flowStage）：舊資料沒有這些欄位，所以全部是選填，前端用 deriveFlowStage 推導
             (!('flowStage' in data) || data.flowStage in ['to_edit', 'client_review', 'revising', 'to_upload', 'ready']) &&
             (!('flowSince' in data) || data.flowSince is string) &&
             (!('flowLog' in data) || data.flowLog is list) &&
             (!('revisionCount' in data) || data.revisionCount is int) &&
             (!('revisionNote' in data) || data.revisionNote is string) &&
             (!('cloudUploadedAt' in data) || data.cloudUploadedAt is string) &&
             // 剪輯師請款：金額上限放在 schema 而不是角色判斷裡，因為它對所有角色都要生效
             //（老闆自己手滑打 900000 也該被擋）
             (!('editorFee' in data) || (data.editorFee is int && data.editorFee >= 0 && data.editorFee <= 100000)) &&
             (!('billableEditorId' in data) || data.billableEditorId is string) &&
             (!('editorInvoiceId' in data) || data.editorInvoiceId is string) &&
             (!('legacySettlementStatus' in data) || data.legacySettlementStatus in ['paid', 'unpaid', 'needs_review']) &&
             (!('legacySettledAt' in data) || data.legacySettledAt is string) &&
             (!('legacySettledAmount' in data) || (data.legacySettledAmount is int && data.legacySettledAmount >= 0 && data.legacySettledAmount <= 100000)) &&
             (!('legacySettlementNote' in data) || data.legacySettlementNote is string) &&
             (!('legacySettlementSource' in data) || data.legacySettlementSource is string) &&
             (!('legacyReviewedAt' in data) || data.legacyReviewedAt is string) &&
             (!('legacyReviewedByUid' in data) || data.legacyReviewedByUid is string) &&
             (!('isUrgent' in data) || data.isUrgent is bool);
    }

    function isValidDismissedHabit(data) {
      return data.keys().hasAll(['vendorId', 'habitTime', 'date']) &&
             data.vendorId is string &&
             data.habitTime is string &&
             data.date is string;
    }

    function isValidBillingContract(data) {
      return data.keys().hasAll(['vendorId', 'services', 'billingDay', 'totalAmount', 'status']) &&
             data.vendorId is string &&
             data.services is list &&
             data.billingDay is int && data.billingDay >= 1 && data.billingDay <= 31 &&
             data.totalAmount is int &&
             data.status in ['active', 'paused', 'ended'];
    }

    function isValidBillingRecord(data) {
      return data.keys().hasAll(['vendorId', 'contractId', 'billingMonth', 'dueDate', 'amount', 'status']) &&
             data.vendorId is string &&
             data.contractId is string &&
             data.billingMonth is string &&
             data.dueDate is string &&
             data.amount is int &&
             data.status in ['pending', 'paid', 'overdue'];
    }

    function isValidEditorInvoice(data) {
      return data.keys().hasAll(['editorId', 'editorName', 'submittedByUid', 'billingMonth',
                                 'items', 'itemCount', 'totalAmount', 'status', 'submittedAt', 'createdAt']) &&
             isValidString(data.editorId, 200) &&
             data.editorName is string &&
             data.submittedByUid is string &&
             data.billingMonth is string && data.billingMonth.size() == 7 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 200 &&
             data.itemCount is int && data.itemCount == data.items.size() &&
             // 規則沒有迴圈，逐筆明細驗不了。金額造假的最後防線是這個上限
             // ＋ asset 端的 editorFee <= 100000 ＋ 老闆付款前肉眼複核。
             data.totalAmount is int && data.totalAmount >= 0 && data.totalAmount <= 1000000 &&
             data.status in ['submitted', 'approved', 'payment_processing', 'paid', 'void'] &&
             data.submittedAt is string &&
             data.createdAt is string &&
             (!('note' in data) || data.note is string) &&
             (!('approvedAt' in data) || data.approvedAt is string) &&
             (!('approvedByUid' in data) || data.approvedByUid is string) &&
             (!('processingAt' in data) || data.processingAt is string) &&
             (!('processingByUid' in data) || data.processingByUid is string) &&
             (!('paidAt' in data) || data.paidAt is string) &&
             (!('paidByUid' in data) || data.paidByUid is string) &&
             (!('voidedAt' in data) || data.voidedAt is string) &&
             (!('voidReason' in data) || data.voidReason is string) &&
             (data.status != 'approved' || (
               data.approvedAt is string && data.approvedByUid is string
             )) &&
             (data.status != 'payment_processing' || (
               data.approvedAt is string && data.approvedByUid is string &&
               data.processingAt is string && data.processingByUid is string
             )) &&
             (data.status != 'paid' || (
               data.paidAt is string && data.paidByUid is string
             )) &&
             (data.status != 'void' || (
               data.voidedAt is string && data.voidReason is string
             ));
    }

    function isValidEditorInvoiceTransition() {
      return (resource.data.status == 'submitted' && request.resource.data.status in ['approved', 'void'])
        || (resource.data.status == 'approved' && request.resource.data.status in ['payment_processing', 'void'])
        || (resource.data.status == 'payment_processing' && request.resource.data.status in ['paid', 'void']);
    }

    function isValidLineUser(data) {
      return data.keys().hasAll(['lineUserId', 'createdAt']) &&
             data.lineUserId is string &&
             data.createdAt is string &&
             (!('linePictureUrl' in data) || data.linePictureUrl is string) &&
             (!('lineDisplayName' in data) || data.lineDisplayName is string) &&
             (!('UserId' in data) || data.UserId is string);
    }

    match /users/{uid} {
      // Own profile is always readable (needed to resolve role at login);
      // reading other users' docs or listing the whole collection requires manager/engineer.
      allow get: if isAuthenticated() && (isOwner(uid) || isManager());
      allow list: if isManager();
      allow create: if (isAuthenticated() && request.auth.uid == uid) || isManager() || !exists(/databases/$(database)/documents/users/$(uid));
      allow update: if (isManager() && !touchesDeficitPermission()) || isAdmin();
      allow delete: if isAdmin();
    }

    match /version_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /vendors/{vendorId} {
      allow read: if isAuthenticated() && editorCanAccessVendor(vendorId);
      allow create: if isManager() && isValidVendor(request.resource.data);
      allow update: if isValidVendor(request.resource.data) && (
        (isManager() && !touchesDeficitBaseline()) ||
        (canEditDeficitBaseline() && touchesOnlyDeficitBaseline())
      );
      allow delete: if isAdmin();
    }

    // 2026-08-19 新增：客戶社群帳號密碼從 vendor 文件搬出來的落點（文件 id ＝ vendorId）。
    // 原因見 types.ts 的 VendorSecrets：Firestore 沒有欄位級讀取控制，密碼跟廠商資料同一份
    // 文件時，EditorAssetQueue 的整份文件訂閱會讓外包剪輯師的瀏覽器裡直接有明碼密碼。
    // 邊界刻意跟 billingContracts 一致——擋 editor 就好，不收成 isManager()：
    // 廠商管理分頁 employee 也進得去，小編要用客戶帳號發文，收太緊會擋到真實工作流。
    match /vendorSecrets/{vendorId} {
      allow read: if isAuthenticated() && !isEditorRole();
      allow create, update: if isManager();
      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if isAuthenticated() && editorCanAccessVendor(resource.data.vendorId);
      allow create: if isAuthenticated() && !isEditorRole() && isValidPost(request.resource.data);
      allow update: if isAuthenticated() && !isEditorRole() && isValidPost(request.resource.data);
      allow delete: if isManager();
    }

    match /assets/{assetId} {
      allow read: if isAuthenticated() && editorCanAccessAsset(resource.data);
      allow create: if isAuthenticated() && !isEditorRole() && isValidAsset(request.resource.data);
      allow update: if isAuthenticated() && isValidAsset(request.resource.data)
        // 請款鎖：已入單的片，金額與綁定關係一律凍結（不分角色，老闆自己也不行 —— 這是帳務完整性，
        // 不是權限問題）。editorInvoiceId 因此只能 unset→set 一次，剪輯師無法清掉重複請款。
        && (!touchesBillingFields() || !assetInvoiced() || internalUnlockingInvoice())
        && billableEditorIsSelf()
        // 一般 employee 可以維護素材流程，但不能碰剪輯費、請款鎖或新舊帳結算。
        // editor 需要在自己的請款流程寫 editorFee/editorInvoiceId；manager 以上負責財務覆核。
        && (isEditorRole() || isManager() || !touchesBillingFields())
        // 改派剪輯師＝改帳務歸屬的前置，已入單的片一律凍結（不分角色）。
        // 刻意不塞進 touchesBillingFields()：那條的效果是「只有 editor/manager 能碰」，
        // 會把 employee 擋掉，但改派本來就要讓小編做得到。
        && (!touchesEditorAssignment() || !assetInvoiced())
        && (
          !isEditorRole() || (
            editorCanAccessAsset(resource.data) &&
            editorCanAccessAsset(request.resource.data) &&
            isEditorAssetUpdate()
          )
        );
      // 刪除保護：剪輯師已標記上傳雲端（＝已可請款）或已納入請款單的片一律不可刪。
      // 刪掉是不可逆的，等於把外包的請款依據抹掉。業主不用那支的話請改按「封存」。
      allow delete: if isManager()
        && resource.data.get('cloudUploadedAt', '') == ''
        && resource.data.get('editorInvoiceId', '') == '';
    }

    // 尚未審片原因屬公司內部工作紀錄；外包剪輯師不可讀取或寫入。
    match /assetReviewNotes/{assetId} {
      allow read, create, update, delete: if isAuthenticated() && !isEditorRole();
    }

    match /editors/{editorId} {
      allow read: if isAuthenticated();
      // 請款單引用 editorId/editorName，這份名冊等於薪酬對象清單，剪輯師本人絕不該能改。
      // 不收斂到 isManager() 是因為廠商管理（employee 也能進）的「新增剪輯師」在用。
      allow create: if isAuthenticated() && !isEditorRole();
      allow update: if isAuthenticated() && !isEditorRole();
      allow delete: if isManager();
    }

    // 剪輯師請款單。金額一經送出就凍結，連 manager 都只能改狀態，不能動明細。
    match /editorInvoices/{invoiceId} {
      // ⚠️ 剪輯師端的 list 查詢必須自帶 where('editorId','==',自己)，
      // 否則整個查詢會 permission-denied（不是回空陣列）。
      // employee 沒有理由看得到外包薪資，所以不開 isAuthenticated 全讀。
      allow read: if isManager()
        || (isEditorRole() && resource.data.editorId == myEditorId());

      // 只能開給自己、只能以 submitted 起始（不能自己開成已付款）
      allow create: if isAuthenticated()
        && isValidEditorInvoice(request.resource.data)
        && request.resource.data.status == 'submitted'
        && request.resource.data.submittedByUid == request.auth.uid
        && !('paidAt' in request.resource.data)
        && (
          (isEditorRole() && request.resource.data.editorId == myEditorId())
          || isManager()   // 老闆代開（剪輯師忘了送單）
        );

      // 標記已請款／作廢：manager 以上，且明細與金額全程不可變動
      allow update: if isManager()
        && isValidEditorInvoice(request.resource.data)
        && isValidEditorInvoiceTransition()
        && request.resource.data.editorId == resource.data.editorId
        && request.resource.data.billingMonth == resource.data.billingMonth
        && request.resource.data.items == resource.data.items
        && request.resource.data.itemCount == resource.data.itemCount
        && request.resource.data.totalAmount == resource.data.totalAmount
        && request.resource.data.submittedByUid == resource.data.submittedByUid;

      allow delete: if isAdmin();
    }

    match /shootBookings/{bookingId} {
      allow read: if isAuthenticated() && editorCanAccessVendor(resource.data.vendorId);
      allow create: if isAuthenticated() && !isEditorRole();
      allow update: if isAuthenticated() && !isEditorRole();
      allow delete: if isManager();
    }

    match /dismissedHabits/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidDismissedHabit(request.resource.data);
      allow delete: if isManager();
    }

    // 2026-08-19 收斂：原本 read 是 isAuthenticated()，代表**外包剪輯師登入後就讀得到
    // 全部客戶的合約金額、月結應收與付款狀態**。UI 靠 App.tsx 的 TAB_ROLES.billing 把帳務
    // 分頁藏起來，但規則不管 UI——devtools 發一個查詢就全拿。
    // 改成排除 editor 角色而不是直接收成 isManager()：Dashboard 的「待核收帳款」卡片
    // employee 也看得到(Dashboard.tsx:520)，收成 isManager() 會讓內部員工的儀表板
    // 靜靜地 permission-denied。要不要連 employee 一起擋是產品決定，不在這次止血範圍。
    match /billingContracts/{id} {
      allow read: if isAuthenticated() && !isEditorRole();
      allow create: if isManager() && isValidBillingContract(request.resource.data);
      allow update: if isManager() && isValidBillingContract(request.resource.data);
      allow delete: if isAdmin();
    }

    match /billingRecords/{id} {
      allow read: if isAuthenticated() && !isEditorRole();
      allow create: if isManager() && isValidBillingRecord(request.resource.data);
      allow update: if isManager() && isValidBillingRecord(request.resource.data);
      allow delete: if isAdmin();
    }

    // 2026-08-19 收斂：原本 create 是 `if true`＝未認證的公開寫入面，任何人都能往這兩個
    // collection 灌文件(身分綁定資料，之後客戶身分若走 LINE 就是偽造面)。
    // 真正的寫入者是 server.ts 的 LINE follow webhook，它走 admin SDK **完全不受規則管**，
    // 所以關掉客戶端 create 不影響綁定流程(已確認前端沒有任何 addDoc 到這兩個 collection)。
    // read 同時收成 manager：客戶端只有員工管理頁(users 分頁＝engineer/manager)在讀，
    // 內容是同事的 LINE 顯示名稱與頭像，沒有理由讓外包剪輯師讀得到。
    match /line_users/{id} {
      allow read: if isManager();
      allow create: if isManager() && isValidLineUser(request.resource.data);
      allow update: if isManager() && isValidLineUser(request.resource.data);
      allow delete: if isAdmin();
    }

    match /line_connections/{id} {
      allow read: if isManager();
      allow create: if isManager();
      allow update: if isManager();
      allow delete: if isAdmin();
    }
  }
}

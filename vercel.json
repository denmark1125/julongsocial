{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/stock-alert-push",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/flow-stale-push",
      "schedule": "30 1 * * *"
    }
  ]
}
